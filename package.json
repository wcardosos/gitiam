{
  "name": "@wcardosos/gitiam",
  "version": "0.1.1",
  "description": "Atomic git identity switching for the shell",
  "type": "module",
  "bin": {
    "gitiam": "dist/index.cjs"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": ["git", "ssh", "identity", "cli"],
  "repository": { "type": "git", "url": "git+https://github.com/wcardosos/gitiam.git" },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
